{
    "tasks": [
        {
            "type": "shell",
            "label": "Build SalonSystem",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-Wall",
                "-static",
                "-o",
                "${workspaceFolder}${pathSeparator}SalonSystem.exe",
                "${workspaceFolder}${pathSeparator}main.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build main.cpp"
        }
    ],
    "version": "2.0.0"
}
